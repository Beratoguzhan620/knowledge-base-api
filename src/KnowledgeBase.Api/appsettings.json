{
  "ConnectionStrings": {
    "KnowledgeBase": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "knowledge-base",
    "Audience": "knowledge-base-clients",
    "AccessTokenMinutes": 60
  },
  "Auth": {
    "AttemptsPerMinute": 10
  },
  "Embeddings": {
    "Provider": "Local",
    "BaseUrl": "",
    "Model": "nomic-embed-text",
    "DocumentPrefix": "",
    "QueryPrefix": "",
    "BatchSize": 32,
    "TimeoutSeconds": 120
  },
  "Indexer": {
    "Workers": 2,
    "MaxAttempts": 5,
    "LeaseMinutes": 10,
    "PollSeconds": 5
  },
  "Limits": {
    "MaxFileMegabytes": 10,
    "WorkspaceStorageMegabytes": 100,
    "ChunkCharacters": 1200
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
